# --- App ---
# Public base URL of this deployment (no trailing slash), e.g. https://try.quillory.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign feedback links and other one-time tokens (any long random string)
APP_SECRET=change-me-to-a-long-random-string

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- VAPI (voice screening) ---
VAPI_API_KEY=
# The VAPI phone number ID used as caller ID for outbound screening calls
VAPI_PHONE_NUMBER_ID=
# Shared secret VAPI sends in the x-vapi-secret header on webhooks
VAPI_WEBHOOK_SECRET=

# --- Twilio (SMS notifications + SMS screening fallback) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# --- Stripe (try-day payment) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform fee in percent of the try-day total (e.g. 10 = 10%)
PLATFORM_FEE_PERCENT=10

# --- Anthropic (scores the SMS-fallback screening) ---
ANTHROPIC_API_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=
EMAIL_FROM="Try Jobs <notifications@quillory.app>"
